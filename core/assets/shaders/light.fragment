#ifdef GL_ES
    #define PRECISION mediump
    precision PRECISION float;
#else
    #define PRECISION
#endif

varying vec2 v_texCoord;
varying vec4 v_color;

uniform sampler2D u_texture0;
uniform sampler2D u_lightmap;
uniform vec4 u_ambient;

uniform int u_type;
uniform vec2 u_uv;
uniform vec2 u_uv2;
uniform vec2 u_texsize;
uniform int u_ditherEnabled;
uniform float u_ditherSize;
uniform float u_ditherStrength;
uniform sampler2D u_dither;

void main(){
    if(u_type == 0){
        vec2 coords = (v_texCoord - u_uv) / (u_uv2 - u_uv);
        float dist = distance(coords, vec2(0.5));
        float falloff = clamp(1.0 - dist * 2.0, 0.0, 1.0);
        float smoothCoverage = clamp(v_color.a * falloff * falloff * 4.0, 0.0, 1.0);
        float coverage;

        if(u_ditherEnabled == 1){
            vec2 ditherCoords = floor(gl_FragCoord.xy / u_ditherSize);
            float threshold = texture2D(u_dither, ditherCoords / 4.0).r;
            float stipple = falloff > threshold ? clamp(v_color.a * 4.0, 0.0, 1.0) : 0.0;

            //keep the center smooth; the stipple only ramps in toward the light edge
            float ditherMix = smoothstep(0.20, 0.65, dist);
            coverage = mix(smoothCoverage, stipple, ditherMix * u_ditherStrength);
        }else{
            coverage = smoothCoverage;
        }

        gl_FragColor = vec4(mix(u_ambient.rgb, v_color.rgb, coverage), 0.5);
    }else{
        vec4 colors = texture2D(u_texture0, v_texCoord);
        vec4 light = texture2D(u_lightmap, v_texCoord);

        vec3 finalLight = max(vec3(1.0 - u_ambient.a), light.rgb);

        gl_FragColor = vec4(colors.rgb * finalLight, colors.a);
    }
}
