#ifdef GL_ES
precision mediump float;
#endif

#ifndef SCATTER_OUT
#define SCATTER_OUT 3
#endif
#ifndef SCATTER_IN
#define SCATTER_IN 3
#endif

const int numOutScatter = SCATTER_OUT;
const float fNumOutScatter = float(SCATTER_OUT);
const int numInScatter = SCATTER_IN;
const float fNumInScatter = float(SCATTER_IN);

const float pi = 3.14159265359;
const float peak = 0.1;
const float flare = 0.0025;
const float intensity = 14.3;
const float gm = -0.85;

varying vec3 v_world;
varying vec3 v_normal;

uniform vec3 u_campos;
uniform vec3 u_light;
uniform vec3 u_color;
uniform float u_inner;
uniform float u_outer;
uniform float u_alpha;
uniform float u_intensity;

vec2 intersectSphere(vec3 ray_origin, vec3 ray_dir, float radius){
    float b = dot(ray_origin, ray_dir);
    float c = dot(ray_origin, ray_origin) - radius * radius;
    float d = b * b - c;
    if(d < 0.0) return vec2(10000.0, -10000.0);
    d = sqrt(d);
    return vec2(-b - d, -b + d);
}

float miePhase(float g, float c, float cc){
    float gg = g * g;
    float a = (1.0 - gg) * (1.0 + cc);
    float b = 1.0 + gg - 2.0 * g * c;
    b *= sqrt(b);
    b *= 2.0 + gg;
    return 1.5 * a / b;
}

float rayleighPhase(float cc){
    return 0.75 * (1.0 + cc);
}

float density(vec3 p){
    return exp(-(length(p) - u_inner) * (4.0 / (u_outer - u_inner)));
}

float optic(vec3 p, vec3 q){
    vec3 step = (q - p) / fNumOutScatter;
    vec3 v = p + step * 0.5;
    float sum = 0.0;
    for(int i = 0; i < numOutScatter; i++){
        sum += density(v);
        v += step;
    }
    sum *= length(step) * (1.0 / (u_outer - u_inner));
    return sum;
}

vec3 inScatter(vec3 eye, vec3 ray, vec2 bound, vec3 light){
    float len = (bound.y - bound.x) / fNumInScatter;
    len = min(len, u_inner * 0.5);

    vec3 step = ray * len;
    vec3 start = eye + ray * bound.x;
    vec3 march = start + ray * (len * 0.5);

    vec3 sum = vec3(0.0);
    for(int i = 0; i < numInScatter; i++){
        vec2 f = intersectSphere(march, light, u_outer);
        vec3 u = march + light * f.y;
        float n = (optic(start, march) + optic(march, u)) * (pi * 4.0);
        sum += density(march) * exp(-n * (peak * u_color + flare));
        march += step;
    }

    sum *= len * (1.0 / (u_outer - u_inner));
    float c = dot(ray, -light);
    float cc = c * c;
    return sum * (peak * u_color * rayleighPhase(cc) + flare * miePhase(gm, c, cc)) * intensity;
}

void main(){
    vec3 eye = u_campos;
    vec3 ray = normalize(v_world - u_campos);

    vec2 bound = intersectSphere(eye, ray, u_outer);
    vec2 inner = intersectSphere(eye, ray, u_inner);
    if(inner.x > 0.0){
        bound.y = min(bound.y, inner.x);
    }
    if(bound.y <= bound.x || bound.y <= 0.0){
        discard;
    }

    gl_FragColor = vec4(inScatter(eye, ray, bound, normalize(u_light)) * u_intensity * u_alpha, 1.0);
}
