#ifdef GL_ES
	#define PRECISION mediump
	precision PRECISION float;
#else
	#define PRECISION
#endif

uniform PRECISION sampler2D u_texture0;
uniform PRECISION sampler2D u_texture1;
uniform float BloomIntensity;
uniform float OriginalIntensity;
uniform float u_ps1;
uniform vec2 u_ps1Resolution;

varying vec2 v_texCoords;

void main(){
	vec2 uv = v_texCoords;
	vec2 pixel = vec2(0.0);

	if(u_ps1 > 0.5){
		pixel = floor(v_texCoords * u_ps1Resolution);
		uv = (pixel + 0.5) / u_ps1Resolution;
	}

	vec4 original = texture2D(u_texture0, uv) * OriginalIntensity;
	vec4 bloom = texture2D(u_texture1, uv) * BloomIntensity;
	vec3 color = original.rgb + bloom.rgb * 0.6;

	if(u_ps1 > 0.5){
		float dither = mod(pixel.x + pixel.y, 2.0);
		color += (dither - 0.5) / 24.0;
		color = floor(color * 24.0 + 0.5) / 24.0;
	}

	gl_FragColor = vec4(color, original.a);
}
